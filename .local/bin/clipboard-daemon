#!/bin/sh
# Small X11 clipboard history daemon for the LARBS/dwm session.

set -u
history_dir="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard"
history_file="$history_dir/history"
image_dir="$history_dir/images"
mkdir -p "$history_dir"
mkdir -p "$image_dir"
touch "$history_file"

# Prevent multiple daemons from racing over clipboard ownership and history.
lock_file="$history_dir/.daemon.lock"
exec 9>"$lock_file"
flock -n 9 || exit 0

last=""
last_image=""
while :; do
    targets=$(xclip -selection clipboard -o -t TARGETS 2>/dev/null || true)
    case "$targets" in
        *UTF8_STRING*|*STRING*)
            current=$(xclip -selection clipboard -o -t UTF8_STRING 2>/dev/null || true)
            ;;
        *)
            # Non-text clipboard data is handled by the image history below.
            current=""
            ;;
    esac
    if [ -n "$current" ] && [ "$current" != "$last" ]; then
        one_line=$(printf '%s' "$current" | tr '\n\r\t' '   ' | sed 's/[[:space:]]\{2,\}/ /g')
        if [ -n "$one_line" ]; then
            tmp=$(mktemp "$history_dir/.history.XXXXXX")
            {
                printf '%s\t%s\n' "$(date +%s)" "$one_line"
                awk -F '\t' -v text="$one_line" 'NF >= 2 && $2 == text { next } { print }' "$history_file" 2>/dev/null || true
            } | head -n 100 >"$tmp"
            mv -f "$tmp" "$history_file"
        fi
        last=$current
    fi
    case "$targets" in
        *image/png*)
            tmp=$(mktemp "$image_dir/.clipboard.XXXXXX.png")
            if timeout 2 xclip -selection clipboard -o -t image/png >"$tmp" 2>/dev/null; then
                image_hash=$(sha256sum "$tmp" | awk '{print $1}')
                if [ -s "$tmp" ] && [ "$image_hash" != "$last_image" ]; then
                    image_file="$image_dir/$(date +%Y%m%d-%H%M%S)-$image_hash.png"
                    mv -f "$tmp" "$image_file"
                    find "$image_dir" -type f -name '*.png' -printf '%T@ %p\n' |
                        sort -nr | tail -n +101 | cut -d' ' -f2- | xargs -r rm -f
                    last_image=$image_hash
                elif [ -s "$tmp" ]; then
                    existing=$(find "$image_dir" -type f -name "*-$image_hash.png" -print -quit)
                    [ -n "$existing" ] && touch "$existing"
                    rm -f "$tmp"
                else
                    rm -f "$tmp"
                fi
            else
                rm -f "$tmp"
            fi
            ;;
    esac
    sleep 0.5
done
