#!/usr/bin/env python3
"""Create a rebuilt PDF without page annotations, links, or form widgets."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def main() -> int:
    if len(sys.argv) not in (2, 3):
        print(
            f"Usage: {Path(sys.argv[0]).name} INPUT.pdf [OUTPUT.pdf]",
            file=sys.stderr,
        )
        return 2

    source = Path(sys.argv[1]).expanduser()
    try:
        source = source.resolve(strict=True)
    except FileNotFoundError:
        return fail(f"PDF not found: {sys.argv[1]}")
    if not source.is_file() or source.suffix.lower() != ".pdf":
        return fail("Choose a regular .pdf file.")

    gs = shutil.which("gs")
    pdfinfo = shutil.which("pdfinfo")
    if not gs:
        return fail("Ghostscript is required. Install it with: sudo pacman -S ghostscript")
    if not pdfinfo:
        return fail("pdfinfo is required. Install poppler.")

    output = (
        Path(sys.argv[2]).expanduser().absolute()
        if len(sys.argv) == 3
        else source.with_name(f"{source.stem}-no-annotations.pdf")
    )
    if output == source:
        return fail("The output path must differ from the source; the original is kept intact.")
    if output.exists():
        return fail(f"Refusing to overwrite: {output}")
    if not output.parent.is_dir():
        return fail(f"Output directory does not exist: {output.parent}")

    try:
        subprocess.run(
            [pdfinfo, str(source)],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return fail("The selected file is not a readable PDF.")

    fd, temp_name = tempfile.mkstemp(
        prefix=".neomutt-pdf-clean-", suffix=".pdf", dir=output.parent
    )
    os.close(fd)
    temporary = Path(temp_name)
    try:
        subprocess.run(
            [
                gs,
                "-q",
                "-dSAFER",
                "-dBATCH",
                "-dNOPAUSE",
                "-dShowAnnots=false",
                "-dShowAcroForm=false",
                "-dPDFSETTINGS=/prepress",
                "-sDEVICE=pdfwrite",
                f"-sOutputFile={temporary}",
                str(source),
            ],
            check=True,
            stdout=subprocess.DEVNULL,
        )
        subprocess.run(
            [pdfinfo, str(temporary)],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        # Link creation is atomic and fails if another file appeared at output.
        os.link(temporary, output)
    except FileExistsError:
        return fail(f"Refusing to overwrite: {output}")
    except (OSError, subprocess.CalledProcessError) as error:
        return fail(f"Could not create a clean PDF: {error}")
    finally:
        temporary.unlink(missing_ok=True)

    print(f"Created: {output}")
    print("Review it before attaching: PDF links, form widgets, and annotations were removed.")
    print("The source file was left unchanged; rewritten PDFs no longer retain digital signatures.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
