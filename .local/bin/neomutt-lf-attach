#!/usr/bin/env python3
"""Use lf to choose files and queue NeoMutt attach-file keystrokes."""

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path


config_dir = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "mutt"
commands_file = config_dir / "lf-attach.muttrc"


def write_commands(paths: list[str]) -> None:
    config_dir.mkdir(parents=True, exist_ok=True)
    lines = []
    for path in paths:
        if "\n" in path or "\r" in path:
            print(f"Cannot attach a file with a newline in its name: {path!r}", file=sys.stderr)
            continue
        escaped = path.replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'push <attach-file>"{escaped}"<enter>\n')

    fd, temp_name = tempfile.mkstemp(prefix=".lf-attach-", dir=config_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.writelines(lines)
        os.replace(temp_name, commands_file)
    except Exception:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else "pick"
    if mode == "clean":
        write_commands([])
        return 0
    if mode != "pick":
        print(f"Usage: {Path(sys.argv[0]).name} [pick|clean]", file=sys.stderr)
        return 2

    config_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(prefix="lf-attach-selection-", delete=False) as selection:
        selection_path = Path(selection.name)
    try:
        download_dir = os.environ.get("XDG_DOWNLOAD_DIR")
        if not download_dir:
            candidate = Path.home() / "Downloads"
            download_dir = str(candidate if candidate.is_dir() else Path.home())
        try:
            subprocess.run(
                [
                    "lf",
                    "-command",
                    'set promptfmt "Space: select, l: attach, q: cancel [%w] %S"',
                    "-selection-path",
                    str(selection_path),
                    download_dir,
                ],
                check=False,
            )
            selected = selection_path.read_text(encoding="utf-8").splitlines()
        except FileNotFoundError:
            print("lf is not installed or could not be started.", file=sys.stderr)
            selected = []
        write_commands(selected)
    finally:
        selection_path.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
