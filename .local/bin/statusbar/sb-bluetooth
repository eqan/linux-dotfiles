#!/bin/sh

. "$(dirname "$0")/icons"

case $BLOCK_BUTTON in
    1) setsid -f "$HOME/.local/bin/btmenu" ;;
    3) notify-send "Bluetooth" "Left click opens the device menu." ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

if timeout 1 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
	printf '%s On\n' "$ICON_BLUETOOTH"
else
	printf '%s Off\n' "$ICON_BLUETOOTH"
fi
