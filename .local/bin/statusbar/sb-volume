#!/bin/sh

. "$(dirname "$0")/icons"

case $BLOCK_BUTTON in
	1) setsid -w -f "${TERMINAL:-st}" -e pulsemixer; pkill -RTMIN+10 "${STATUSBAR:-dwmblocks}" ;;
	2) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
	4) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ --limit 1.0 ;;
	5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- --limit 1.0 ;;
	3) notify-send "Volume" "Middle click toggles mute; scroll changes the level." ;;
	6) setsid -f "${TERMINAL:-st}" -e "${EDITOR:-nvim}" "$0" ;;
esac

vol="$(timeout 1 wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
muted=0
value=''

if printf '%s\n' "$vol" | grep -q '^Volume:'; then
	value=$(printf '%s\n' "$vol" | awk '/^Volume:/ { printf "%.0f", $2 * 100; exit }')
	printf '%s\n' "$vol" | grep -q '\[MUTED\]' && muted=1
else
	# PipeWire can briefly be unavailable while Bluetooth or WirePlumber restarts.
	# Fall back to the PulseAudio-compatible interface instead of going blank.
	value="$(timeout 1 pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '
		/Volume:/ {
			for (i = 1; i <= NF; i++)
				if ($i ~ /^[0-9]+%$/) { sub(/%/, "", $i); print $i; exit }
		}')"
	if timeout 1 pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes'; then
		muted=1
	fi
fi

[ -n "$value" ] || { printf '%s --%%\n' "$ICON_VOLUME_MUTE"; exit; }

if [ "$muted" -eq 1 ] || [ "$value" -eq 0 ]; then
	icon=$ICON_VOLUME_MUTE
elif [ "$value" -ge 70 ]; then
	icon=$ICON_VOLUME_HIGH
else
	icon=$ICON_VOLUME_LOW
fi

printf '%s %s%%\n' "$icon" "$value"
